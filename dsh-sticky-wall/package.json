{
  "name": "@local/dsh-sticky-wall",
  "version": "1.1.0",
  "private": true,
  "description": "A sticky-note wall in the DSH Web sidebar: capture inspiration at any time.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
