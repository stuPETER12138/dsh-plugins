{
  "name": "@local/dsh-session-share",
  "version": "0.2.1",
  "private": true,
  "description": "Pick any part of the current conversation and share it as Markdown, an image, or a PDF — tables, images and LaTeX formulas are laid out on-device.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "stuPETER12138",
    "url": "https://github.com/stuPETER12138"
  },
  "homepage": "https://github.com/stuPETER12138/dsh-plugins/tree/main/dsh-session-share",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuPETER12138/dsh-plugins.git",
    "directory": "dsh-session-share"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "share",
    "export",
    "markdown",
    "pdf",
    "png",
    "latex",
    "math"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "tools",
    "notes",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
