{
  "name": "@local/dsh-style-studio",
  "version": "1.3.0",
  "private": true,
  "description": "Style Studio: a Visual styles row in Settings → General with five application-wide visual styles.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "stuPETER12138",
    "url": "https://github.com/stuPETER12138"
  },
  "homepage": "https://github.com/stuPETER12138/dsh-plugins/tree/main/dsh-style-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuPETER12138/dsh-plugins.git",
    "directory": "dsh-style-studio"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "style",
    "appearance",
    "dark-mode"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
