{
  "name": "@local/dsh-usage-stats",
  "version": "1.1.0",
  "private": true,
  "description": "Token usage and estimated cost dashboard in the DSH Web sidebar, computed from this machine's real session logs.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "stuPETER12138",
    "url": "https://github.com/stuPETER12138"
  },
  "homepage": "https://github.com/stuPETER12138/dsh-plugins/tree/main/dsh-usage-stats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuPETER12138/dsh-plugins.git",
    "directory": "dsh-usage-stats"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tokens",
    "cost",
    "usage",
    "statistics",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "API.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
