{
  "name": "@local/dsh-gamepad-voice",
  "version": "1.1.0",
  "private": true,
  "description": "A left-sidebar Xbox One controller page: button-labelled gamepad control and local voice dictation for DSH.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": {
    "name": "stuPETER12138",
    "url": "https://github.com/stuPETER12138"
  },
  "homepage": "https://github.com/stuPETER12138/dsh-plugins/tree/main/dsh-gamepad-voice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stuPETER12138/dsh-plugins.git",
    "directory": "dsh-gamepad-voice"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gamepad",
    "controller",
    "voice",
    "dictation",
    "speech",
    "sidebar",
    "手柄",
    "语音输入",
    "语音转写"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
